#!/bin/bash
set -euo pipefail

# FVAIOS Installer
# Installs FVAIOS to disk from Live environment

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Logo
show_logo() {
    clear
    echo -e "${CYAN}"
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║                                                               ║"
    echo "║     ███████╗██╗  ██╗██╗ ██████╗    ███████╗                   ║"
    echo "║     ██╔════╝╚██╗██╔╝██║██╔════╝    ██╔════╝                   ║"
    echo "║     █████╗   ╚███╔╝ ██║██║         ███████╗                   ║"
    echo "║     ██╔══╝   ██╔██╗ ██║██║         ╚════██║                   ║"
    echo "║     ███████╗██╔╝ ██╗██║╚██████╗    ███████║                   ║"
    echo "║     ╚══════╝╚═╝  ╚═╝╚═╝ ╚═════╝    ╚══════╝                   ║"
    echo "║                                                               ║"
    echo "║                   Linux Installer v1.0.0                      ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

# Logging
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_step() {
    echo -e "${BLUE}[STEP]${NC} $1"
}

# Check if running as root
check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        log_error "This script must be run as root (use sudo)"
        exit 1
    fi
}

# Check dependencies
check_deps() {
    log_info "Checking dependencies..."
    local deps=("lsblk" "blkid" "fdisk" "parted" "mkfs.ext4" "mkfs.vfat" "grub-install" "rsync" "mount" "umount")
    local missing=()

    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            missing+=("$dep")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        log_error "Missing dependencies: ${missing[*]}"
        log_info "Install with: apk add ${missing[*]}"
        exit 1
    fi
    log_info "All dependencies satisfied"
}

# List disks
list_disks() {
    log_step "Available disks:"
    echo ""
    echo -e "${CYAN}┌─────────────────────────────────────────────────────────────┐${NC}"
    echo -e "${CYAN}│ ID │   Device   │     Model      │    Size    │   Type    │${NC}"
    echo -e "${CYAN}├─────────────────────────────────────────────────────────────┤${NC}"

    local idx=0
    while IFS= read -r line; do
        local dev=$(echo "$line" | awk '{print $1}')
        local size=$(echo "$line" | awk '{print $4}')
        local model=$(lsblk -dno MODEL "/dev/$dev" 2>/dev/null || echo "Unknown")
        local type=$(lsblk -dno TYPE "/dev/$dev" 2>/dev/null || echo "Unknown")

        printf "${CYAN}│${NC} %2d ${CYAN}│${NC} %-10s ${CYAN}│${NC} %-14s ${CYAN}│${NC} %-10s ${CYAN}│${NC} %-9s ${CYAN}│${NC}\n" \
            "$idx" "/dev/$dev" "$model" "$size" "$type"

        idx=$((idx + 1))
    done < <(lsblk -dno NAME,SIZE,MODEL,TYPE | grep -E "^[a-z]|^nvme" | awk '{print $1, $2, $3, $4}')

    echo -e "${CYAN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
}

# Select disk
select_disk() {
    local disks=()
    while IFS= read -r line; do
        disks+=("$line")
    done < <(lsblk -dno NAME | grep -E "^[a-z]|^nvme" | awk '{print $1}')

    if [ ${#disks[@]} -eq 0 ]; then
        log_error "No disks found"
        exit 1
    fi

    echo -e "${YELLOW}Enter disk number (0-${#disks[@]}-1) or device name (e.g., sda, nvme0n1):${NC}"
    read -r choice

    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        if [ "$choice" -lt 0 ] || [ "$choice" -ge ${#disks[@]} ]; then
            log_error "Invalid selection"
            exit 1
        fi
        TARGET_DISK="${disks[$choice]}"
    else
        TARGET_DISK="$choice"
    fi

    if [ ! -b "/dev/$TARGET_DISK" ]; then
        log_error "Device /dev/$TARGET_DISK does not exist"
        exit 1
    fi

    log_info "Selected disk: /dev/$TARGET_DISK"
}

# Confirm formatting
confirm_format() {
    log_warn "WARNING: All data on /dev/$TARGET_DISK will be erased!"
    echo ""
    echo -e "${RED}Are you sure you want to continue? (yes/no):${NC}"
    read -r confirm

    if [ "$confirm" != "yes" ]; then
        log_info "Installation cancelled"
        exit 0
    fi
}

# Unmount existing partitions
unmount_existing() {
    log_info "Unmounting existing partitions on /dev/$TARGET_DISK..."

    # Unmount any mounted partitions
    while read -r mount_point; do
        umount "$mount_point" 2>/dev/null || true
    done < <(findmnt -rno TARGET "/dev/$TARGET_DISK" 2>/dev/null)

    # Disable swap
    swapoff "/dev/$TARGET_DISK"* 2>/dev/null || true
}

# Partition disk
partition_disk() {
    log_step "Partitioning disk..."

    # Create partition table
    parted -s "/dev/$TARGET_DISK" mklabel gpt

    # Create EFI partition (512MB)
    parted -s "/dev/$TARGET_DISK" mkpart primary fat32 1MiB 513MiB
    parted -s "/dev/$TARGET_DISK" set 1 esp on

    # Create boot partition (1GB)
    parted -s "/dev/$TARGET_DISK" mkpart primary ext4 513MiB 1537MiB

    # Create root partition (remaining space)
    parted -s "/dev/$TARGET_DISK" mkpart primary ext4 1537MiB 100%

    # Wait for partitions to be created
    partprobe "/dev/$TARGET_DISK"
    sleep 2

    log_info "Partitions created"
}

# Format partitions
format_partitions() {
    log_step "Formatting partitions..."

    # Determine partition naming convention
    if [[ "$TARGET_DISK" == *"nvme"* ]]; then
        EFI_PART="/dev/${TARGET_DISK}p1"
        BOOT_PART="/dev/${TARGET_DISK}p2"
        ROOT_PART="/dev/${TARGET_DISK}p3"
    else
        EFI_PART="/dev/${TARGET_DISK}1"
        BOOT_PART="/dev/${TARGET_DISK}2"
        ROOT_PART="/dev/${TARGET_DISK}3"
    fi

    # Format EFI partition
    log_info "Formatting EFI partition..."
    mkfs.vfat -F32 -n "EFI" "$EFI_PART"

    # Format boot partition
    log_info "Formatting boot partition..."
    mkfs.ext4 -q -L "boot" "$BOOT_PART"

    # Format root partition
    log_info "Formatting root partition..."
    mkfs.ext4 -q -L "root" "$ROOT_PART"

    log_info "Partitions formatted"
}

# Mount partitions
mount_partitions() {
    log_step "Mounting partitions..."

    # Determine partition naming convention
    if [[ "$TARGET_DISK" == *"nvme"* ]]; then
        EFI_PART="/dev/${TARGET_DISK}p1"
        BOOT_PART="/dev/${TARGET_DISK}p2"
        ROOT_PART="/dev/${TARGET_DISK}p3"
    else
        EFI_PART="/dev/${TARGET_DISK}1"
        BOOT_PART="/dev/${TARGET_DISK}2"
        ROOT_PART="/dev/${TARGET_DISK}3"
    fi

    # Create mount points
    mkdir -p /mnt
    mkdir -p /mnt/boot
    mkdir -p /mnt/boot/efi

    # Mount root partition
    mount "$ROOT_PART" /mnt

    # Mount boot partition
    mount "$BOOT_PART" /mnt/boot

    # Mount EFI partition
    mount "$EFI_PART" /mnt/boot/efi

    log_info "Partitions mounted"
}

# Copy rootfs
copy_rootfs() {
    log_step "Copying rootfs..."

    # Source is the live filesystem
    SOURCE="/"

    # Copy everything except mounted partitions
    rsync -aAXv \
        --exclude={"/dev/*", "/proc/*", "/sys/*", "/tmp/*", "/run/*", "/mnt/*", "/media/*", "/lost+found", "/swapfile"} \
        "$SOURCE" "/mnt/"

    log_info "Rootfs copied"
}

# Install bootloader
install_bootloader() {
    log_step "Installing bootloader..."

    # Chroot and install GRUB
    mount --bind /dev /mnt/dev
    mount --bind /dev/pts /mnt/dev/pts
    mount -t proc proc /mnt/proc
    mount -t sysfs sysfs /mnt/sys

    chroot /mnt /bin/sh << CHROOT_SCRIPT
set -eu

# Get disk name from parent device
DISK=\$(lsblk -ndo PKNAME "$ROOT_PART" 2>/dev/null | head -1)
[ -z "\$DISK" ] && DISK="$TARGET_DISK"

# Configure fstab
ROOT_UUID=\$(blkid -s UUID -o value "$ROOT_PART")
BOOT_UUID=\$(blkid -s UUID -o value "$BOOT_PART")
EFI_UUID=\$(blkid -s UUID -o value "$EFI_PART")

cat > /etc/fstab << FSTAB
# <file system>  <mount point>  <type>  <options>  <dump>  <pass>
UUID=\$ROOT_UUID   /         ext4  defaults,noatime  0 1
UUID=\$BOOT_UUID   /boot     ext4  defaults,noatime  0 2
UUID=\$EFI_UUID    /boot/efi vfat  defaults,noatime  0 3
FSTAB

# Install GRUB for BIOS
grub-install --target=i386-pc --boot-directory=/boot /dev/\$DISK || true

# Install GRUB for UEFI
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=FVAIOS || true

# Generate GRUB config
grub-mkconfig -o /boot/grub/grub.cfg

# Set root password
echo "root:fvaios" | chpasswd

# Enable services
rc-update add nginx default
rc-update add php-fpm81 default
rc-update add sshd default
rc-update add networking boot
rc-update add udev-boot boot

# Configure networking
cat > /etc/network/interfaces << INTERFACES
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
INTERFACES

# Set hostname
echo "fvaios" > /etc/hostname

# Set timezone
echo "UTC" > /etc/timezone
CHROOT_SCRIPT

    # Unmount
    umount /mnt/dev/pts 2>/dev/null || true
    umount /mnt/dev 2>/dev/null || true
    umount /mnt/proc 2>/dev/null || true
    umount /mnt/sys 2>/dev/null || true

    log_info "Bootloader installed"
}

# Cleanup
cleanup() {
    log_info "Cleaning up..."

    # Unmount all
    umount /mnt/boot/efi 2>/dev/null || true
    umount /mnt/boot 2>/dev/null || true
    umount /mnt 2>/dev/null || true
}

# Main installation function
main() {
    show_logo
    check_root
    check_deps

    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║                    FVAIOS Installation                       ║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo ""

    list_disks
    select_disk
    confirm_format

    unmount_existing
    partition_disk
    format_partitions
    mount_partitions
    copy_rootfs
    install_bootloader

    cleanup

    echo ""
    echo -e "${GREEN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║                 Installation Complete!                       ║${NC}"
    echo -e "${GREEN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}FVAIOS has been installed to /dev/$TARGET_DISK${NC}"
    echo -e "${YELLOW}Please remove the installation media and reboot.${NC}"
    echo ""
    echo -e "${CYAN}Default credentials:${NC}"
    echo -e "  Root: ${GREEN}root / fvaios${NC}"
    echo -e "  User: ${GREEN}fvaios / fvaios${NC}"
    echo ""
    echo -e "${YELLOW}Press Enter to reboot, or Ctrl+C to stay in Live mode...${NC}"
    read -r

    reboot
}

# Run main function
main "$@"
